#!/bin/sh
# Re-evaluate the Pi-MFX hotspot when a network link changes.
IFACE="${1:-}"
ACTION="${2:-}"
case "$ACTION" in
    up|down|connectivity-change|dhcp4-change|dhcp6-change) ;;
    *) exit 0 ;;
esac
[ "$IFACE" = "lo" ] && exit 0
HELPER="@PREFIX@/libexec/pimfx/hotspot.py"
[ -f "$HELPER" ] || exit 0
exec /usr/bin/python3 "$HELPER" apply --nowait
