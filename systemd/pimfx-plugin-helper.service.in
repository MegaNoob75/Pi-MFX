[Unit]
Description=Pi-MFX plugin helper (apt and extra repos)
Documentation=https://github.com/MegaNoob75/Pi-MFX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=PIMFX_USER=@USER@
Environment=PIMFX_DATA_ROOT=@DATA_ROOT@
ExecStart=/usr/bin/python3 @PREFIX@/libexec/pimfx/plugin-helper.py /run/pimfx/plugin-helper.sock
RuntimeDirectory=pimfx
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2

# Already root; do not let the helper gain extra capabilities.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
