[Unit]
Description=Pi-MFX plugin helper (apt and extra repos)
Documentation=https://github.com/MegaNoob75/Pi-MFX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=PIMFX_USER=@USER@
Environment=PIMFX_DATA_ROOT=@DATA_ROOT@
Environment=PIMFX_PREFIX=@PREFIX@
Environment=PIMFX_REPO=@REPO@
ExecStart=/usr/bin/python3 @PREFIX@/libexec/pimfx/plugin-helper.py /run/pimfx/plugin-helper.sock
RuntimeDirectory=pimfx
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2

# Already root; do not let the helper gain extra capabilities.
# Do not set RestrictSUIDSGID: apt-get drops to the _apt user (uid 42) and
# local .deb installs fail with "seteuid 42" / "Method file has died".
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=no
# The clone usually lives in a user home directory. ProtectHome would hide it
# from git fetch/checkout during Settings → Updates.
ReadWritePaths=@DATA_ROOT@ @REPO@ /run/pimfx /home
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
