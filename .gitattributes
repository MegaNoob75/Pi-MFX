# Shell scripts must stay Unix text so the Pi can run them.
*.sh text eol=lf
*.py text eol=lf
*.plymouth text eol=lf
*.script text eol=lf
*.service.in text eol=lf
# JSON and modprobe conf are fine as CRLF on Windows. Forcing LF here makes
# GitHub Desktop list them as dirty with no text change.
*.json text
systemd/*.conf text
*.ps1 text eol=crlf
