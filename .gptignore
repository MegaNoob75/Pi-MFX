# ====================================================================
# Master .gptignore for Pi-MFX (dev branch)
# Targets: Python scripts, audio DSP/C++ builds, and editor bloat.
# ====================================================================

# 1. Block Local Git Meta Information
.git/
.github/

# Block heavy binary image design assets and logo kits
branding/

# 8. Documentation Assets (Keep .md files, block embedded image arrays)
docs/images/

# 2. Block Core System & Editor Cache Noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
.cursor_history/

# 3. CRITICAL: Block Cursor Workspaces while preserving your .mdc Rules
.cursor/cache/
.cursor/history/
.cursor/user/

# 4. Python Audio Scripts & Core Wrapper Dependencies
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.tox/
*.egg-info/

# 5. C/C++ Low-Latency Audio DSP Compilation Output
*.o
*.obj
*.so
*.a
*.lib
*.la
*.lo
*.dylib
bin/
build/
dist/
out/
obj/

# 6. Web Dashboard UI Dependencies (If any Node components exist)
node_modules/
bower_components/
.npm/
.yarn/
*.log
*.lock

# 7. Heavy Media Assets & Packages
*.png
*.jpg
*.jpeg
*.wav
*.mp3
*.flac
*.zip
*.tar.gz
